// SPDX-License-Identifier: GPL-2.0+
/*
 * ZynqSDR Rev.5 — U-Boot device tree
 * Board: ZynqSDR Rev.5 (XC7Z020-CLG400 + AD9363)
 *
 * Based on zynq-pluto-sdr.dts (U-Boot 2016, tezuka_fw/libre).
 * Adapted for u-boot-xlnx 2025.1:
 *   - #include headers from the official ADI repository instead of custom ones
 *   - linux,stdout-path (legacy format) removed — in 2025.1
 *   - chosen: stdout-path as a string reference to an alias (recommended format)
 *   - flash: fixed to match actual chip W25Q256 (Winbond)
 *   - align partition node names with their flash offsets, in accordance with the DT specification.
 *   - u-boot,dm-pre-reloc  →  bootph-all  (required in 2025.1)
 *   - mdio {} wrapper required by new DM ETH
 *   - PHY reset-gpios: GPIO46, active-low (polarity 0)
 */
/dts-v1/;
#include "zynq-7000.dtsi"

/ {
	model = "LibreSDR Rev.5 (Z7020-AD9363)";
	compatible = "xlnx,zynq-7000";

	aliases {
		ethernet0 = &gem0;
		serial0 = &uart0;
		spi0 = &qspi;
	};

	memory {
		device_type = "memory";
		reg = <0x0 0x40000000>;
	};

	chosen {
		bootargs = "earlyprintk";
		stdout-path = "serial0:115200n8";
	};

	usb_phy0: phy0 {
		compatible = "usb-nop-xceiv";
		#phy-cells = <0>;
	};

	gpio_keys {
		compatible = "gpio-keys";
		#address-cells = <1>;
		#size-cells = <0>;
		button {
			label = "Button";
			gpios = <&gpio0 12 0>;
			linux,code = <103>; /* up */
			wakeup-source;
			autorepeat;
		};
	};
};

&qspi {
	status = "okay";
	is-dual = <0>;
	num-cs = <1>;

	flash@0 {
		compatible = "winbond,w25q256", "jedec,spi-nor";
		/*
		 * QSPI — Winbond W25Q256 (32 MiB)
		 * Chip confirmed in boot log: "SF: Detected W25Q256"
		 * Previous compatible "n25q512a","micron,m25p80" was incorrect. 
		 */
		reg = <0x0>;
		spi-tx-bus-width = <1>;
		spi-rx-bus-width = <4>;
		spi-max-frequency = <50000000>;
		#address-cells = <1>;
		#size-cells = <1>;
		partition@0 {
			label = "qspi-fsbl-uboot";
			reg = <0x000000 0x100000>; /* 1 MiB */
		};
		partition@100000 {
			label = "qspi-uboot-env";
			reg = <0x100000 0x020000>; /* 128 KiB */
		};
		partition@120000 {
			label = "qspi-nvmfs";
			reg = <0x120000 0x0E0000>; /* 896 KiB */
		};
		partition@200000 {
			label = "qspi-linux";
			reg = <0x200000 0x1E00000>; /* 30 MiB */
		};
	};
};

&uart0 {
	status = "okay";
};

&usb0 {
	status = "okay";
	dr_mode = "host";
	usb-phy = <&usb_phy0>;
};

&sdhci0 {
	bootph-all;
	status = "okay";
};

&gem0 {
	status = "okay";
	phy-mode = "rgmii-id";
	phy-handle = <&ethernet_phy0>;

	mdio {
		#address-cells = <1>;
		#size-cells = <0>;
		ethernet_phy0: ethernet-phy@0 {
			reg = <0>;
			reset-gpios = <&gpio0 46 0>;
		};
	};
};
