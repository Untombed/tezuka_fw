# zynqsdr_defconfig
# ZynqSDR Rev.5 (XC7Z020-CLG400 + AD9363)
# Baza: xilinx_zynq_virt_defconfig (u-boot-xlnx 2025.1)
# Bez SPL — oryginalny FSBL laduje u-boot.elf bezposrednio.
#
# Kluczowe zalozenia:
#   - Boot z SD (FAT env, overlayfs + pluto.itb)
#   - FIT image z weryfikacja (md5)
#   - USB host + gadget (ADI VID/PID jak w tezuka)
#   - QSPI W25Q256 dostepne ale nie jest medium bootowania
#   - Brak sieci w U-Boot (CMD_NET=n, jak w starym konfig)
#   - Prompt: LIBRESDR> (zachowany z libre)

CONFIG_ARM=y
CONFIG_SYS_CONFIG_NAME="zynq_pluto-sdr"
CONFIG_ARCH_ZYNQ=y
CONFIG_SYS_MALLOC_F_LEN=0x800

# TEXT_BASE: adres ladowania U-Boot przez FSBL.
# 0x4000000 = 64M — standardowy adres dla Zynq bez SPL.
CONFIG_TEXT_BASE=0x4000000

CONFIG_DEFAULT_DEVICE_TREE="zynq-pluto-sdr"
CONFIG_SPL=y

# ---- FIT / Image ----
CONFIG_FIT=y
CONFIG_FIT_VERBOSE=y
CONFIG_FIT_SIGNATURE=y
CONFIG_LEGACY_IMAGE_FORMAT=y
CONFIG_SYS_BOOTM_LEN=0x3c00000

# ---- Boot ----
CONFIG_BOOTDELAY=3
CONFIG_HUSH_PARSER=y
CONFIG_SYS_PROMPT="LIBRESDR> "
CONFIG_USE_PREBOOT=y
CONFIG_CLOCKS=y

CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="if load mmc 0:1 0x2000000 uEnv.txt; then env import -t 0x2000000 $filesize; fi; run uenvboot; run sdboot"

# ---- Load address ----
CONFIG_SYS_LOAD_ADDR=0x0

# ---- Brak NOR flash (CFI) ----
CONFIG_SYS_NO_FLASH=y

# ---- Komendy: wylaczone (jak w starym konfig) ----
# CONFIG_CMD_IMLS is not set
# CONFIG_CMD_XIMG is not set
# CONFIG_CMD_FLASH is not set
# CONFIG_CMD_NET is not set
# CONFIG_CMD_NFS is not set
# CONFIG_CMD_SETEXPR is not set
# CONFIG_BOOTM_NETBSD is not set

# ---- Komendy: wlaczone ----
CONFIG_CMD_SF=y
CONFIG_CMD_SPI=y
CONFIG_CMD_USB=y
CONFIG_CMD_DFU=y
CONFIG_CMD_GPIO=y
CONFIG_CMD_MMC=y
CONFIG_CMD_CACHE=y
CONFIG_CMD_EXT2=y
CONFIG_CMD_EXT4=y
CONFIG_CMD_EXT4_WRITE=y
CONFIG_CMD_FAT=y
CONFIG_CMD_FS_GENERIC=y
CONFIG_CMD_GREPENV=y
CONFIG_CMD_MTDPARTS=y
CONFIG_CMD_MTDPARTS_SPREAD=y
CONFIG_CMD_MTDPARTS_SHOW_NET_SIZES=y

# ---- GPIO ----
CONFIG_DM_GPIO=y
CONFIG_ZYNQ_GPIO=y

# ---- LED ----
CONFIG_LED=y
CONFIG_LED_GPIO=y

# ---- QSPI / SPI-NOR ----
CONFIG_ZYNQ_SPI=y
CONFIG_ZYNQ_QSPI=y
CONFIG_SPI_FLASH_WINBOND=y
CONFIG_SPI_FLASH_ISSI=y
CONFIG_SPI_FLASH_MACRONIX=y
CONFIG_SPI_FLASH_SPANSION=y
CONFIG_SPI_FLASH_STMICRO=y
CONFIG_SPI_FLASH_BAR=y
CONFIG_SPI_FLASH_MTD=y
# CONFIG_SPI_FLASH_USE_4K_SECTORS is not set
CONFIG_SF_DEFAULT_SPEED=30000000

# ---- SD/MMC ----
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_ZYNQ=y

# ---- Environment: FAT na SD ----
# Zachowane z oryginalnego libre defconfig.
# ENV_IS_IN_FAT jako jedyne aktywne zrodlo.
CONFIG_ENV_IS_IN_FAT=y
CONFIG_ENV_FAT_INTERFACE="mmc"
CONFIG_ENV_FAT_DEVICE_AND_PART="0:auto"
CONFIG_ENV_FAT_FILE="uboot.env"
CONFIG_ENV_SIZE=0x20000
# CONFIG_ENV_IS_IN_SPI_FLASH is not set
# CONFIG_ENV_IS_IN_NAND is not set
# CONFIG_ENV_IS_NOWHERE is not set

# ---- Ethernet ----
CONFIG_PHYLIB=y
CONFIG_PHY_REALTEK=y
CONFIG_PHY_MARVELL=y
CONFIG_PHY_MICREL=y
CONFIG_PHY_MICREL_KSZ90X1=y
CONFIG_DM_ETH=y
CONFIG_DM_ETH_PHY=y
CONFIG_MII=y
CONFIG_ZYNQ_GEM=y
CONFIG_NET_RANDOM_ETHADDR=y

# ---- USB host + gadget ----
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_ULPI_VIEWPORT=y
CONFIG_USB_ULPI=y
CONFIG_USB_STORAGE=y
CONFIG_USB_GADGET=y
CONFIG_CI_UDC=y
CONFIG_USB_GADGET_VBUS_DRAW=500
CONFIG_USB_GADGET_DOWNLOAD=y
# ADI VID/PID — zachowane z libre/tezuka
CONFIG_G_DNL_MANUFACTURER="Analog Devices Inc."
CONFIG_G_DNL_VENDOR_NUM=0x0456
CONFIG_G_DNL_PRODUCT_NUM=0xb674

# ---- DFU ----
CONFIG_DFU_MMC=y
CONFIG_DFU_SF=y
CONFIG_SYS_DFU_DATA_BUF_SIZE=0x600000
CONFIG_DFU_TIMEOUT=y

# ---- FPGA ----
CONFIG_FPGA_XILINX=y
CONFIG_FPGA_ZYNQPL=y

# ---- Serial ----
CONFIG_ZYNQ_SERIAL=y

# ---- Misc ----
CONFIG_OF_EMBED=y
CONFIG_REGEX=y
CONFIG_LIB_RAND=y
CONFIG_SYS_MAXARGS=32
CONFIG_SYS_PBSIZE=2071
